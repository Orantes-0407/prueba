<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_analytic_show" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.analytic.show</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- Buscamos la columna del precio unitario o subtotal e insertamos el campo analítico antes -->
            <xpath expr="//field[@name='order_line']/list//field[@name='price_subtotal']" position="before">
                <field name="analytic_distribution" widget="analytic_distribution" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>